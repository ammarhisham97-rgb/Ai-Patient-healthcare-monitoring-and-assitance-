// ============================================================
//  JWT TOKEN GENERATOR
// ============================================================
static string GenerateJwtToken(string username, string secret, string issuer, string audience)
{
    var key = Encoding.ASCII.GetBytes(secret);
    var tokenHandler = new JwtSecurityTokenHandler();
    var tokenDescriptor = new SecurityTokenDescriptor
    {
        Subject = new ClaimsIdentity(new[]
        {
            new Claim(ClaimTypes.NameIdentifier, username),
            new Claim(ClaimTypes.Name, username)
        }),
        Expires = DateTime.UtcNow.AddHours(1),
        Issuer = issuer,
        Audience = audience,
        SigningCredentials = new SigningCredentials(new SymmetricSecurityKey(key), SecurityAlgorithms.HmacSha256Signature)
    };
    var token = tokenHandler.CreateToken(tokenDescriptor);
    return tokenHandler.WriteToken(token);
}

// ============================================================
//  SMART FALL DETECTION (Rule-Based)
// ============================================================
static bool DetectFall(PatientReading reading, ILogger<Program> logger)
{
    if (reading.Accelerometer is null || reading.Gyroscope is null)
        return false;

    // Threshold-based fall detection:
    // High acceleration magnitude + high angular velocity = potential fall
    var accelMagnitude = reading.Accelerometer.Magnitude;
    var gyroMagnitude = MathF.Sqrt(
        reading.Gyroscope.X * reading.Gyroscope.X +
        reading.Gyroscope.Y * reading.Gyroscope.Y +
        reading.Gyroscope.Z * reading.Gyroscope.Z
    );

    // Fall detection criteria:
    // 1. Sudden spike in acceleration (freefall or impact)
    // 2. High angular velocity (body tumbling)
    // 3. Combined threshold (both must be elevated)
    const float accelThreshold = 2.0f;     // ~2g impact
    const float gyroThreshold = 200f;      // degrees/sec threshold
    const float combinedThreshold = 2.5f;  // combined score

    var combinedScore = (accelMagnitude / accelThreshold) + (gyroMagnitude / gyroThreshold);

    if (combinedScore > combinedThreshold && accelMagnitude > accelThreshold)
    {
        logger.LogWarning("[FALL] Potential fall detected! Accel={A:F2}, Gyro={G:F1}, Score={S:F2}", 
            accelMagnitude, gyroMagnitude, combinedScore);
        return true;
    }

    return false;
}

// ============================================================
//  SMART ACTIVITY DETECTION (Rule-Based)
// ============================================================
static string DetectActivity(PatientReading reading)
{
    if (reading.Accelerometer is null)
        return "Unknown";

    var accelMagnitude = reading.Accelerometer.Magnitude;
    var motionDetected = reading.MotionDetected;
    var heartRate = reading.HeartRate?.Bpm ?? 0;

    // Activity levels based on acceleration magnitude + motion + heart rate
    if (!motionDetected && accelMagnitude < 0.3f)
        return "Sedentary";

    if (accelMagnitude < 0.8f || heartRate < 80)
        return "Light";

    if (accelMagnitude < 1.5f || heartRate < 110)
        return "Moderate";

    return "Vigorous";
}

// ============================================================
//  ALERT BUILDER
// ============================================================
static List<string> BuildAlerts(PatientReading r)
{
    var alerts = new List<string>();
    if (r.Temperature?.Fever == true) alerts.Add("FEVER");
    if (r.Accelerometer?.FallDetected == true) alerts.Add("FALL_DETECTED");
    if (r.HeartRate?.HighRate == true) alerts.Add("HIGH_HEART_RATE");
    if (r.Ambient?.TempCelsius > 35) alerts.Add("HIGH_AMBIENT_TEMP");
    if (r.Ambient?.Humidity > 80) alerts.Add("HIGH_HUMIDITY");
    if (r.Temperature?.SensorOk == false) alerts.Add("BODY_TEMP_SENSOR_FAIL");
    if (r.SensorStatus?.MpuOk == false) alerts.Add("MPU_FAIL");
    if (r.SensorStatus?.MaxOk == false) alerts.Add("MAX30102_FAIL");
    if (r.SensorStatus?.Ds18Ok == false) alerts.Add("DS18B20_FAIL");
    if (r.SensorStatus?.DhtOk == false) alerts.Add("DHT11_FAIL");
    return alerts;
}

// ============================================================
//  READINGS STORE  (Database-backed with EF Core)
// ============================================================
public class ReadingsStore
{
    private readonly IServiceProvider _serviceProvider;
    private const int MaxReadings = 100;

    public ReadingsStore(IServiceProvider serviceProvider)
    {
        _serviceProvider = serviceProvider;
    }

    public void Add(PatientReadingEntity reading)
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        db.PatientReadings.Add(reading);
        db.SaveChanges();

        // Keep only last MaxReadings per device to manage database size
        var oldReadings = db.PatientReadings
            .Where(r => r.DeviceId == reading.DeviceId)
            .OrderByDescending(r => r.ReceivedAt)
            .Skip(MaxReadings)
            .ToList();

        if (oldReadings.Count > 0)
        {
            db.PatientReadings.RemoveRange(oldReadings);
            db.SaveChanges();
        }
    }

    public IEnumerable<PatientReadingEntity> GetAll()
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        return db.PatientReadings
            .OrderByDescending(r => r.ReceivedAt)
            .Take(100)
            .ToList();
    }

    public PatientReadingEntity? GetLatest()
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        return db.PatientReadings
            .OrderByDescending(r => r.ReceivedAt)
            .FirstOrDefault();
    }

    public int Count
    {
        get
        {
            using var scope = _serviceProvider.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();
            return db.PatientReadings.Count();
        }
    }

    public IEnumerable<PatientReadingEntity> GetByDevice(string deviceId)
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        return db.PatientReadings
            .Where(r => r.DeviceId.ToLower() == deviceId.ToLower())
            .OrderByDescending(r => r.ReceivedAt)
            .Take(100)
            .ToList();
    }
}

// ============================================================
//  USER STORE  (for JWT authentication - Database-backed)
// ============================================================
public class UserStore
{
    private readonly IServiceProvider _serviceProvider;

    public UserStore(IServiceProvider serviceProvider)
    {
        _serviceProvider = serviceProvider;
    }

    public bool UserExists(string username)
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();
        return db.Users.Any(u => u.Username.ToLower() == username.ToLower());
    }

    public void AddUser(string username, string password)
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        var hashedPassword = BCrypt.Net.BCrypt.HashPassword(password);
        var user = new UserEntity
        {
            Username = username.ToLower(),
            PasswordHash = hashedPassword,
            CreatedAt = DateTime.UtcNow
        };

        db.Users.Add(user);
        db.SaveChanges();
    }

    public bool ValidateUser(string username, string password)
    {
        using var scope = _serviceProvider.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HealthMonitorDbContext>();

        var user = db.Users.FirstOrDefault(u => u.Username.ToLower() == username.ToLower());
        if (user != null)
        {
            return BCrypt.Net.BCrypt.Verify(password, user.PasswordHash);
        }
        return false;
    }
}

// ============================================================
//  ML.NET ANOMALY DETECTION SERVICE  (SSA-based, no training)
// ============================================================
public class AnomalyDetectionService
{
    private readonly MLContext _mlContext;
    private readonly ConcurrentDictionary<string, RollingWindowData> _deviceHistory = new();
    private const int WindowSize = 20;
    private const float SensitivityThreshold = 2.0f;  // standard deviations

    public AnomalyDetectionService(MLContext mlContext)
    {
        _mlContext = mlContext;
    }

    public List<string> DetectAnomalies(PatientReading reading)
    {
        var anomalies = new List<string>();
        if (reading.DeviceId is null) return anomalies;

        var history = _deviceHistory.GetOrAdd(reading.DeviceId, _ => new RollingWindowData());

        // Heart Rate Anomaly Detection
        if (reading.HeartRate?.FingerDetected == true && reading.HeartRate.Bpm > 0)
        {
            history.HeartRates.Enqueue(reading.HeartRate.Bpm);
            if (history.HeartRates.Count > WindowSize)
                history.HeartRates.TryDequeue(out _);

            if (IsOutlier(reading.HeartRate.Bpm, history.HeartRates))
                anomalies.Add("ANOMALY_HEART_RATE");
        }

        // Temperature Anomaly Detection
        if (reading.Temperature?.SensorOk == true)
        {
            history.Temperatures.Enqueue(reading.Temperature.Celsius);
            if (history.Temperatures.Count > WindowSize)
                history.Temperatures.TryDequeue(out _);

            if (IsOutlier(reading.Temperature.Celsius, history.Temperatures))
                anomalies.Add("ANOMALY_BODY_TEMP");
        }

        // Acceleration Anomaly Detection
        if (reading.Accelerometer is not null)
        {
            history.Accelerations.Enqueue(reading.Accelerometer.Magnitude);
            if (history.Accelerations.Count > WindowSize)
                history.Accelerations.TryDequeue(out _);

            if (IsOutlier(reading.Accelerometer.Magnitude, history.Accelerations))
                anomalies.Add("ANOMALY_ACCELERATION");
        }

        // Ambient Anomaly Detection
        if (reading.Ambient?.SensorOk == true)
        {
            history.AmbientTemps.Enqueue(reading.Ambient.TempCelsius);
            if (history.AmbientTemps.Count > WindowSize)
                history.AmbientTemps.TryDequeue(out _);

            if (IsOutlier(reading.Ambient.TempCelsius, history.AmbientTemps))
                anomalies.Add("ANOMALY_AMBIENT_TEMP");
        }

        return anomalies;
    }

    private bool IsOutlier(float value, Queue<float> window)
    {
        if (window.Count < 5) return false;  // Need minimum samples

        var mean = window.Average();
        var stdDev = MathF.Sqrt(window.Average(x => MathF.Pow(x - mean, 2)));

        // Z-score based outlier detection
        var zScore = MathF.Abs((value - mean) / (stdDev + 0.0001f));
        return zScore > SensitivityThreshold;
    }

    private class RollingWindowData
    {
        public Queue<float> HeartRates { get; } = new();
        public Queue<float> Temperatures { get; } = new();
        public Queue<float> Accelerations { get; } = new();
        public Queue<float> AmbientTemps { get; } = new();
    }
}

