app.MapGet("/api/anomalies/summary", (ReadingsStore store) =>
{
    var readings = store.GetAll().ToList();
    var anomalySummary = new
    {
        totalReadings = readings.Count,
        readingsWithAnomalies = readings.Count(r => r.DetectedAnomalies?.Count > 0),
        commonAnomalies = readings
            .Where(r => r.DetectedAnomalies?.Count > 0)
            .SelectMany(r => r.DetectedAnomalies!)
            .GroupBy(a => a)
            .OrderByDescending(g => g.Count())
            .Select(g => new { anomaly = g.Key, count = g.Count() })
            .ToList()
    };
    return Results.Ok(anomalySummary);
});

